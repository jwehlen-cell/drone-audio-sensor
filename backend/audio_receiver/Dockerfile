FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY backend/audio_receiver/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Proto stubs (drone_audio + audio_egress_stats) are generated by the
# cloudbuild protoc step into backend/audio_receiver/src before the
# COPY below.
COPY backend/audio_receiver/src /app/src

ENV PYTHONPATH=/app/src
ENV PORT=8080
EXPOSE 8080

CMD ["python", "-m", "audio_receiver.main"]
