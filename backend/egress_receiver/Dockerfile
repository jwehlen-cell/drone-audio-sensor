FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY backend/egress_receiver/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Proto stubs (egress_batch + egress_service) are generated by the
# cloudbuild protoc step into backend/egress_receiver/src before
# this COPY runs.
COPY backend/egress_receiver/src /app/src

ENV PYTHONPATH=/app/src
ENV PORT=8080
EXPOSE 8080

CMD ["python", "-m", "egress_receiver.main"]
