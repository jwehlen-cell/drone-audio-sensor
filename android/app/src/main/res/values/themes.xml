<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DroneSensor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Screen timeout is left to the OS so the phone can sleep its
             display when nobody's looking at it. The AudioCaptureService
             holds a PARTIAL_WAKE_LOCK that keeps the CPU awake, so
             capture + gRPC streaming + the connectivity watchdog all
             continue when the screen is off. Set keepScreenOn back to
             true if you need the dashboard visible during bench
             validation. -->
    </style>
</resources>
