# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/gateway/proto_gen/

# Protos regenerated at VM startup (see scripts/argos_bridge/startup.sh,
# scripts/argos_live_pull, etc.). Don't commit the generated stubs;
# the source of truth is proto/drone_audio.proto.
scripts/drone_audio_pb2.py
scripts/drone_audio_pb2_grpc.py

# PKI public keys minted by scripts/argos_bridge/mint_test_pki.py;
# the matching private material lives in argosuat Secret Manager.
# Already covered by the *.pem rule below, listed here for clarity.
scripts/argos_bridge/out_pubkeys/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Logs
*.log

# Secrets
*.pem
*.key
*.crt
.env
.env.local
teardown_export_*/

# Sim VM clones the upstream WAV fixtures into this dir at startup.
data/sim_audio_fixtures/

# Source clone used by data/test_clips/build_test_clip.py to mint the
# stream-ready flyby clip. The built artifact (drone_flyby_test_16k_mono.wav
# + ground_truth.json) is committed; the ~280 MB source pool is not.
data/test_clips/DroneAudioDataset/

# egress_publisher generates this in Cloud Build's protoc step.
backend/egress_publisher/src/egress_batch_pb2.py

# egress_receiver: generated by Cloud Build's protoc step.
backend/egress_receiver/src/egress_batch_pb2.py
backend/egress_receiver/src/egress_service_pb2.py
backend/egress_receiver/src/egress_service_pb2_grpc.py

# egress_publisher: also gets egress_service_pb2 generated now.
backend/egress_publisher/src/egress_service_pb2.py
backend/egress_publisher/src/egress_service_pb2_grpc.py
